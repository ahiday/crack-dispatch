#!/bin/bash
dnf install -y httpd
systemctl enable --now httpd
cat > /var/www/html/index.html <<'EOF'
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>CrackDispatch</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    body { margin: 0; font-family: sans-serif; }
    header { background: #1f2937; color: #fff; padding: 10px 16px; }
    #map { height: calc(100vh - 44px); }
  </style>
</head>
<body>
  <header><b>CrackDispatch</b> | sample work orders, New Orleans (made-up data)</header>
  <div id="map"></div>
  <script>
    const map = L.map('map').setView([29.951, -90.075], 13);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19, attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    const jobs = [
      [29.9705, -90.0855, 'Pothole | Canal St | Priority: High'],
      [29.9230, -90.1010, 'Crack seal | St Charles Ave | Priority: Medium'],
      [29.9265, -90.0760, 'Pothole | Magazine St | Priority: Medium'],
      [29.9720, -90.0650, 'Broken sidewalk | Esplanade Ave | Priority: Low'],
      [29.9640, -90.0960, 'Pothole | Tulane Ave | Priority: High']
    ];
    jobs.forEach(j => L.marker([j[0], j[1]]).addTo(map).bindPopup(j[2]));
  </script>
  <footer style="display:none">Served from EC2</footer>
</body>
</html>
EOF
